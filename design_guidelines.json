{
  "theme": "dark",
  "archetype": "4 (Swiss & High-Contrast) + Premium Linear/Stripe Aesthetic",
  "colors": {
    "background_primary": "#0A0F1C",
    "background_secondary": "#111827",
    "background_tertiary": "#1E293B",
    "text_primary": "#FFFFFF",
    "text_secondary": "#94A3B8",
    "accent_primary": "#3B82F6",
    "accent_secondary": "#0EA5E9",
    "accent_warm": "#F59E0B",
    "border_subtle": "rgba(255, 255, 255, 0.1)",
    "glass_background": "rgba(15, 23, 42, 0.6)"
  },
  "typography": {
    "heading_font": "Space Grotesk, sans-serif",
    "body_font": "Manrope, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "scale": {
      "h1": "text-5xl sm:text-6xl tracking-tighter font-bold",
      "h2": "text-3xl sm:text-4xl tracking-tight font-bold",
      "h3": "text-xl sm:text-2xl font-semibold",
      "body": "text-base leading-relaxed",
      "small": "text-sm tracking-wide"
    }
  },
  "spacing_and_layout": {
    "generous_padding": "py-24 sm:py-32",
    "container": "max-w-7xl mx-auto px-6 lg:px-8",
    "grid_bento": "grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6",
    "glassmorphism": "backdrop-blur-xl bg-slate-900/60 border border-white/10 shadow-2xl"
  },
  "animations": {
    "hover_lift": "transition-transform duration-300 hover:-translate-y-2",
    "tilt_card": "hover:rotate-1 hover:scale-[1.02] transition-all duration-300",
    "reveal": "initial opacity-0 translate-y-8, animate to opacity-100 translate-y-0"
  },
  "components": {
    "buttons": "rounded-full px-8 py-3 font-semibold transition-all duration-300 flex items-center gap-2",
    "primary_button": "bg-blue-600 hover:bg-blue-500 text-white shadow-[0_0_20px_rgba(59,130,246,0.3)] hover:shadow-[0_0_30px_rgba(59,130,246,0.5)]",
    "secondary_button": "bg-white/5 hover:bg-white/10 text-white border border-white/10 backdrop-blur-md",
    "skill_bar": "h-2 rounded-full bg-slate-800 overflow-hidden",
    "skill_fill": "h-full bg-gradient-to-r from-blue-600 to-sky-400 rounded-full",
    "card": "rounded-2xl p-6 bg-slate-900/50 border border-white/5 backdrop-blur-sm"
  },
